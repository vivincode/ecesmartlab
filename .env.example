# ==============================================================================
# SmartLab / Component Lending Platform — Environment Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
# NEVER commit .env.local or expose SUPABASE_SERVICE_ROLE_KEY in client code.
# ==============================================================================

# Public Supabase client credentials (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL (used for auth redirects & QR deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Initial Staff Invite Code for seeding institutional_settings
INITIAL_STAFF_INVITE_CODE=STAFF-ACCESS-2026

# Optional: Cron secret for automated overdue loan checks (/api/cron/overdue)
CRON_SECRET=replace-with-secure-random-hex

# Optional: Custom SMTP for unlimited registration verification & notifications
# Example (Gmail App Password): smtp.gmail.com, 465, true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PSG iTech SmartLab <noreply@psgitech.ac.in>"

# Optional: Alternative Email Provider (Resend)
RESEND_API_KEY=
EMAIL_FROM="PSG iTech SmartLab <noreply@yourcollege.edu>"
